{
  "name": "sovereign",
  "version": "0.1.0",
  "description": "Local-first multimodal AI terminal workspace powered by QVAC — offline LLM, OCR, transcription",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "bin": {
    "sovereign": "./bin/sovereign.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:tui": "tsx src/cli/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qvac/sdk": "latest",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "commander": "^12.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "qvac",
    "tether",
    "local-ai",
    "tui",
    "llm",
    "ocr",
    "transcription",
    "offline",
    "sovereign-ai"
  ],
  "license": "MIT"
}
